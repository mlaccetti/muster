{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlaccetti/muster/kit/schemas/brief.v1.json",
  "title": "brief.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "modifiable_paths",
    "done_when",
    "verify_command",
    "out_of_scope",
    "worktree"
  ],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "modifiable_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "done_when": { "type": "string", "minLength": 1 },
    "verify_command": { "type": "string", "minLength": 1 },
    "out_of_scope": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch"],
      "properties": {
        "path": { "type": "string" },
        "branch": { "type": ["string", "null"] }
      }
    },
    "read_first": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tier": {
      "type": "string",
      "enum": ["implement", "review", "plan", "cheap"]
    },
    "harness_hints": { "type": "object" }
  }
}
