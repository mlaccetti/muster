#!/usr/bin/env bash
# Hermetic harness stub for muster tests. Symlink as claude, codex, cursor-agent, agy.
set -euo pipefail
name="$(basename "$0")"
adapter_root="${MUSTER_ADAPTER_ROOT:-$(cd "$(dirname "$0")" && pwd)}"
data_dir="${MUSTER_STUB_DATA:-$(cd "$adapter_root/../data" && pwd)}"
calls_log="${MUSTER_STUB_CALLS:-$data_dir/stub.calls}"

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  if [ -f "$data_dir/$name.version" ]; then
    cat "$data_dir/$name.version"
  else
    echo "$name stub 1.0.0"
  fi
  exit 0
fi

{
  echo "CALL name=$name pwd=$(pwd)"
  for a in "$@"; do echo "ARG $a"; done
  for a in "$@"; do brief="$a"; done
  if [ -n "${brief:-}" ] && [ -f "$brief" ]; then
    echo "BRIEF $brief"
  fi
} >>"$calls_log"

report_path=""
for a in "$@"; do
  case "$a" in
    --report=*) report_path="${a#--report=}" ;;
    --report) : ;;
  esac
done
if [ -z "$report_path" ]; then
  for a in "$@"; do
    case "$a" in
      "Write your final report to"*)
        report_path="${a#Write your final report to }"
        report_path="${report_path% when you are done.}"
        ;;
      *"Write your final report to "*" when you are done."*)
        report_path="${a#*Write your final report to }"
        report_path="${report_path% when you are done.}"
        ;;
    esac
  done
  report_path="${report_path#"${report_path%%[![:space:]]*}"}"
fi

if [ -n "$report_path" ] && [ -f "$data_dir/$name.report.json" ]; then
  cp "$data_dir/$name.report.json" "$report_path"
elif [ -n "$report_path" ] && [ -f "$data_dir/default.report.json" ]; then
  cp "$data_dir/default.report.json" "$report_path"
fi

if [ -f "$data_dir/$name.fixture" ]; then
  cat "$(cat "$data_dir/$name.fixture")"
elif [ -f "$data_dir/$name.stream.jsonl" ]; then
  cat "$data_dir/$name.stream.jsonl"
fi

if [ -f "$data_dir/$name.routing.json" ]; then
  cat "$data_dir/$name.routing.json"
elif [ -f "$data_dir/default.routing.json" ]; then
  cat "$data_dir/default.routing.json"
fi

exit "${MUSTER_STUB_EXIT:-$(cat "$data_dir/$name.rc" 2>/dev/null || echo 0)}"
